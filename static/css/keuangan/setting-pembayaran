.card {
    background: #fff;
    padding: 24px;
    border-radius: 12px;
}

.section-title {
    margin: 32px 0 12px;
    font-size: 18px;
    border-bottom: 1px solid #e5e7eb;
    padding-bottom: 6px;
}

.form-group {
    margin-bottom: 16px;
}

input, textarea, select {
    width: 100%;
    padding: 10px;
    border-radius: 8px;
    border: 1px solid #e5e7eb;
}

.grid-2 {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
}

.grid-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
}

.toggle-card {
    background: #f8fafc;
    padding: 16px;
    border-radius: 10px;
    display: flex;
    gap: 8px;
    align-items: center;
    cursor: pointer;
}

.form-actions {
    margin-top: 24px;
    text-align: right;
}

.btn-primary {
    background: #facc15;
    border: none;
    padding: 10px 18px;
    border-radius: 8px;
    cursor: pointer;
}